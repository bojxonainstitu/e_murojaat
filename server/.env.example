# E-murojat server sozlamalari — nusxa oling:  .env.example → .env  (loyiha ildizida yoki server/ ichida)
# .env faylini hech qachon git'ga yoki brauzerga bermang.

# --- AI tasniflash ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Nutqni matnga oʻgirish (STT) ---
# Haqiqiy provayder hali ulanmagan (server/stt.py ga qarang).
STT_PROVIDER=stub
STT_API_KEY=
# Faqat namoyish uchun: mikrofon yozuvidan soʻng shu matn qaytariladi (boʻsh boʻlsa — "ulanmagan")
STT_DEMO_TEXT=

# --- Server ---
HOST=127.0.0.1
PORT=8765
